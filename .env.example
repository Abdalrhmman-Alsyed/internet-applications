# Copy to .env and change the secrets before any real deployment.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password

RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_password

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password
MINIO_PUBLIC_URL=http://localhost:9000

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded on first start of users-service (admins cannot register through the API)
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@12345

CORS_ORIGINS=http://localhost:3001

# ─── Requirement 4: confirmation email (email-worker) ───
# Left empty → the local test inbox (Mailpit, http://localhost:8025).
# Real external service, e.g. Mailtrap sandbox (mailtrap.io → Email Testing → SMTP settings):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<from Mailtrap>
#   SMTP_PASS=<from Mailtrap>
# or Gmail (needs an App Password: myaccount.google.com → Security → App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-letter app password>
#   MAIL_FROM=Your Shop <you@gmail.com>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
