      "value": "admin@shop.local"
    },
    {
      "key": "adminPassword",
      "value": "Admin@12345"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "customerRefresh",
      "value": ""
    },
    {
      "key": "customer2Token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
