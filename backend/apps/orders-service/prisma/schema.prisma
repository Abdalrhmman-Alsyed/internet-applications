generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma-clients/orders"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDERS_DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String               @id @default(uuid())
  /// Owner (users-service id). No FK across services: database per service.
  userId          String
  status          OrderStatus          @default(PENDING)
  total           Decimal              @db.Decimal(12, 2)
  shippingAddress String
  note            String?
  items           OrderItem[]
  history         OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

/// Snapshot of the product at purchase time (later price changes don't affect old orders).
model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
  @@map("order_items")
}

/// Audit trail: who changed the status and when.
model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}
