{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "apps/api-gateway/src/main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": { "classValidatorShim": true, "introspectComments": true }
          }
        ]
      }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "apps/users-service/src/main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": { "tsConfigPath": "apps/users-service/tsconfig.app.json" }
    },
    "products-service": {
      "type": "application",
      "root": "apps/products-service",
      "entryFile": "apps/products-service/src/main",
      "sourceRoot": "apps/products-service/src",
      "compilerOptions": { "tsConfigPath": "apps/products-service/tsconfig.app.json" }
    },
    "orders-service": {
      "type": "application",
      "root": "apps/orders-service",
      "entryFile": "apps/orders-service/src/main",
      "sourceRoot": "apps/orders-service/src",
      "compilerOptions": { "tsConfigPath": "apps/orders-service/tsconfig.app.json" }
    },
    "notifications-service": {
      "type": "application",
      "root": "apps/notifications-service",
      "entryFile": "apps/notifications-service/src/main",
      "sourceRoot": "apps/notifications-service/src",
      "compilerOptions": { "tsConfigPath": "apps/notifications-service/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    }
  }
}
