# Local development (services run on the host, infrastructure runs in Docker:
#   docker compose up -d postgres rabbitmq minio   ← from the repo root)
# Copy to backend/.env

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

RABBITMQ_URL=amqp://app:app_password@localhost:5672

USERS_DATABASE_URL=postgresql://app:app_password@localhost:5433/users_db
PRODUCTS_DATABASE_URL=postgresql://app:app_password@localhost:5433/products_db
ORDERS_DATABASE_URL=postgresql://app:app_password@localhost:5433/orders_db
NOTIFICATIONS_DATABASE_URL=postgresql://app:app_password@localhost:5433/notifications_db

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=products
MINIO_PUBLIC_URL=http://localhost:9000

ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@12345

CORS_ORIGINS=http://localhost:3001
